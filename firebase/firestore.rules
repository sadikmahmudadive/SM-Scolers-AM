rules_version = '2';

// Client access is read-only. Every write goes through server actions or the
// bridge using the Admin SDK, which bypasses these rules.
// Custom claims: { role, personId? }. people.managerId holds the manager's Auth uid.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.get('role', null);
    }
    function isAdmin() {
      return signedIn() && role() == 'admin';
    }
    function isManager() {
      return signedIn() && role() == 'manager';
    }
    function isStaff() {
      return signedIn() && role() == 'staff';
    }
    function isGuardian() {
      return signedIn() && role() == 'guardian';
    }
    function hasRole() {
      return signedIn() && role() in ['admin', 'manager', 'staff', 'guardian'];
    }
    function ownPersonId() {
      return request.auth.token.get('personId', null);
    }
    function personDoc(personId) {
      return get(/databases/$(database)/documents/people/$(personId)).data;
    }
    function personReadableBy(person, personId) {
      return isAdmin()
        || (isManager() && person.get('managerId', null) == request.auth.uid)
        || (isStaff() && ownPersonId() == personId)
        || (isGuardian() && request.auth.uid in person.get('guardianUids', []));
    }

    match /people/{personId} {
      allow read: if personReadableBy(resource.data, personId);
      allow write: if false;
    }

    match /attendance/{recordId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.personId == ownPersonId())
        || ((isManager() || isGuardian())
            && exists(/databases/$(database)/documents/people/$(resource.data.personId))
            && personReadableBy(personDoc(resource.data.personId), resource.data.personId));
      allow write: if false;
    }

    match /schedules/{id} {
      allow read: if hasRole();
      allow write: if false;
    }

    match /holidays/{id} {
      allow read: if hasRole();
      allow write: if false;
    }

    match /bridgeStatus/{id} {
      allow read: if isAdmin() || isManager();
      allow write: if false;
    }

    match /smsLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /devices/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /commands/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
