<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SM Scolers Attendance" Language="1033" Version="13.0.0.0" Manufacturer="SM Scolers" UpgradeCode="8d6b52e9-7a35-4c36-abd5-df4e3a2c09db">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="SM Scolers Attendance Management System v13.0"
             Comments="Biometric attendance with Firebase sync and GSM notifications" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://smscolers.com" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Directory layout -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="SM Scolers Attendance" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="SM_ScolersPrograms" Name="SM Scolers Attendance" />
      </Directory>
    </Directory>

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="..\Icon.ico" />

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComp" Guid="9f36048a-b3d0-4f5f-9515-0f82f7567a7c">
        <Shortcut Id="DesktopShortcut"
                  Name="SM Scolers Attendance"
                  Description="Launch SM Scolers Attendance v13.0"
                  Target="[INSTALLFOLDER]app.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\SM Scolers Attendance" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcuts -->
    <DirectoryRef Id="SM_ScolersPrograms">
      <Component Id="StartMenuShortcutComp" Guid="c62f3f7f-2c37-4f90-9c8a-6e63c7f55453">
        <Shortcut Id="StartMenuShortcut"
                  Name="SM Scolers Attendance"
                  Description="Launch SM Scolers Attendance v13.0"
                  Target="[INSTALLFOLDER]app.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall SM Scolers Attendance"
                  Description="Remove SM Scolers Attendance"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU" Key="Software\SM Scolers Attendance" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramMenuFolder" Directory="SM_ScolersPrograms" On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- Install UI -->
    <UIRef Id="WixUI_InstallDir" />

    <!-- Main feature: everything is required -->
    <Feature Id="MainFeature" Title="SM Scolers Attendance" Description="Complete application with all dependencies" Level="1" Absent="disallow">
      <ComponentGroupRef Id="AppPayload" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
    </Feature>
  </Product>
</Wix>
