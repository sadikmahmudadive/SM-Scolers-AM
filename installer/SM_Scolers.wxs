<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SM Scolers Attendance" Language="1033" Version="13.0.0.0" Manufacturer="SM Scolers" UpgradeCode="8d6b52e9-7a35-4c36-abd5-df4e3a2c09db">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="SM Scolers Attendance Management System v13.0"
             Comments="Biometric attendance with Firebase sync, GSM SMS, PDF reports, and more"
             Keywords="attendance,biometric,firebase,sms,school"
             Manufacturer="SM Scolers" />

    <!-- ========== Properties ========== -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://smscolers.com" />
    <Property Id="ARPCOMMENTS" Value="SM Scolers Attendance Management System — Biometric attendance with Firebase sync and GSM notifications" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SM Scolers Attendance" />
    <Property Id="LicenseAccepted" Value="0" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ========== Custom bitmaps — branded installer look ========== -->
    <WixVariable Id="WixUIDialogBmp"  Value="dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp"  Value="banner.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ========== Launch-on-finish custom action ========== -->
    <CustomAction Id="SetLaunchTarget" Property="WixShellExecTarget" Value="[INSTALLFOLDER]app.exe" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="SetLaunchTarget" After="CostFinalize" />
    </InstallExecuteSequence>

    <!-- ========== Directory layout ========== -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="SM Scolers Attendance" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="SM_ScolersPrograms" Name="SM Scolers Attendance" />
      </Directory>
    </Directory>

    <!-- ========== Icons ========== -->
    <Icon Id="AppIcon" SourceFile="..\Icon.ico" />

    <!-- ========== Desktop shortcut ========== -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComp" Guid="9f36048a-b3d0-4f5f-9515-0f82f7567a7c">
        <Shortcut Id="DesktopShortcut"
                  Name="SM Scolers Attendance"
                  Description="Launch SM Scolers Attendance v13.0"
                  Target="[INSTALLFOLDER]app.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\SM Scolers Attendance" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ========== Start Menu shortcuts ========== -->
    <DirectoryRef Id="SM_ScolersPrograms">
      <Component Id="StartMenuShortcutComp" Guid="c62f3f7f-2c37-4f90-9c8a-6e63c7f55453">
        <Shortcut Id="StartMenuShortcut"
                  Name="SM Scolers Attendance"
                  Description="Launch SM Scolers Attendance v13.0"
                  Target="[INSTALLFOLDER]app.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall SM Scolers Attendance"
                  Description="Remove SM Scolers Attendance"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU" Key="Software\SM Scolers Attendance" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramMenuFolder" Directory="SM_ScolersPrograms" On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- ========== UI Configuration ========== -->
    <!-- Use standard WixUI_InstallDir: Welcome → License → InstallDir → Verify → Progress → Finish -->
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <UI>
      <!-- Wire launch checkbox on the standard ExitDialog -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = "1" AND NOT Installed
      </Publish>
    </UI>

    <!-- ========== Main Feature ========== -->
    <Feature Id="MainFeature" Title="SM Scolers Attendance"
             Description="Complete application with biometric attendance, Firebase sync, SMS alerts, and PDF reports"
             Level="1" Absent="disallow">
      <ComponentGroupRef Id="AppPayload" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
    </Feature>
  </Product>
</Wix>
